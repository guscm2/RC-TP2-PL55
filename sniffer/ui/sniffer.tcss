FilterBar {
    height: 3;
    dock: top;
}

FilterBar Horizontal {
    height: 3;
}

FilterBar #query-input {
    width: 1fr;
}

FilterBar #bpf-input {
    width: 1fr;
}

FilterBar #bpf-apply {
    width: 14;
    min-width: 14;
}

PacketTable {
    height: 60%;
}

DetailPanel {
    height: 1fr;
}

DetailPanel #detail-scroll {
    height: 1fr;
}

.layer-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    border-right: solid $panel-lighten-1;
}

.layer-ether {
    width: 0.6fr;
}

.layer-ip {
    width: 0.75fr;
}

.layer-fragment {
    width: 0.7fr;
    color: $warning;
}

.raw-col {
    width: 58;
}

#capture-status {
    width: 12;
    min-width: 12;
    content-align: center middle;
}

SetupScreen {
    align: center middle;
}

#setup-box {
    width: 52;
    height: auto;
    padding: 2 4;
    border: solid $primary;
    background: $surface;
}

#setup-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#setup-iface-label {
    margin-bottom: 1;
}

InterfaceSelector {
    height: 3;
    margin-bottom: 1;
}

#setup-subtitle {
    margin-bottom: 1;
}

#setup-mode {
    margin-bottom: 1;
}

#setup-pkt-count {
    margin-bottom: 1;
}

#setup-error {
    color: $error;
    margin-bottom: 1;
}

#setup-start {
    width: 100%;
}
