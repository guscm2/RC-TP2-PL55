FilterBar {
    height: 3;
    dock: top;
}

FilterBar Horizontal {
    height: 3;
}

InterfaceSelector {
    width: 20;
    min-width: 20;
}

InterfaceSelector Select {
    width: 20;
}

FilterBar #query-input {
    width: 1fr;
}

FilterBar #bpf-input {
    width: 1fr;
}

FilterBar #bpf-apply {
    width: 14;
    min-width: 14;
}

PacketTable {
    height: 60%;
}

DetailPanel {
    height: 1fr;
}

DetailPanel #detail-scroll {
    height: 1fr;
}

.layer-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    border-right: solid $panel-lighten-1;
}

.layer-ether {
    width: 0.6fr;
}

.layer-ip {
    width: 0.75fr;
}

.raw-col {
    width: 58;
}

#capture-status {
    width: 12;
    min-width: 12;
    content-align: center middle;
}
